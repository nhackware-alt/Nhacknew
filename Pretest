function TPHelpers.FindClosestByName(name, maxRadius)
    maxRadius = maxRadius or 99999
    local ch = LocalPlayer.Character
    if not ch then return nil end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local meuPos = hrp.Position
    local best, bestDist = nil, maxRadius
    local function scan(p)
        for _, item in ipairs(p:GetChildren()) do
            if item.Name == name then
                local pos
                if item:IsA("BasePart") then pos = item.Position
                elseif item:IsA("Model") then
                    local ok, pp = pcall(function() return item:GetPivot().Position end)
                    if ok then pos = pp end
                end
                if pos then
                    local d = (pos - meuPos).Magnitude
                    if d < bestDist then best, bestDist = pos, d end
                end
            end
            if #item:GetChildren() > 0 then scan(item) end
        end
    end
    scan(Workspace)
    return best, bestDist
end

