    local LV = RP.CFrame.LookVector
    local FLV = Vector3.new(LV.X, 0, LV.Z)
    if FLV.Magnitude <= 0.001 then FLV = Vector3.new(0, 0, -1) else FLV = FLV.Unit end
    local CCF = CFrame.lookAt(RP.Position, RP.Position + FLV)
