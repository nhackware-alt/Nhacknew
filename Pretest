function ESP.criarESP(objeto, texto, cor)
    local existente = objeto:FindFirstChild("ESP_" .. texto)
    if existente then
        local lbl = existente:FindFirstChildOfClass("TextLabel")
        if lbl then lbl.TextColor3 = cor end
        return existente
    end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_" .. texto
    billboard.Adornee = objeto
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 5000
    local label = Instance.new("TextLabel")
    label.Text = texto
    label.BackgroundColor3 = Color3.new(0, 0, 0)
    label.BackgroundTransparency = 0.4
    label.TextColor3 = cor
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = billboard
    billboard.Parent = objeto
    return billboard
end

function ESP.limparESPs(pasta, tipo)
    local function remover(p)
        for _, item in ipairs(p:GetChildren()) do
            local esp = item:FindFirstChild("ESP_" .. tipo)
            if esp then esp:Destroy() end
            if #item:GetChildren() > 0 then remover(item) end
        end
    end
    if pasta then remover(pasta) end
end

function ESP.iniciarOGMoney()
    if ESP.ogMoneyLoop then task.cancel(ESP.ogMoneyLoop) end
    ESP._ogMoneyCache = ESP._ogMoneyCache or {}
    local function atualizar()
        local TV = Workspace:FindFirstChild("TreeVisuals")
        if not TV then return end
        local cache = ESP._ogMoneyCache
        for obj, gui in pairs(cache) do
            if not obj.Parent then
                cache[obj] = nil
            end
        end
        for _, item in ipairs(TV:GetDescendants()) do
            if item.Name == "OG_Money" and not cache[item] then
                local adornee = item.PrimaryPart or item:FindFirstChild("Middle") or item
                cache[item] = ESP.criarESP(adornee, "💰 OG_Money", Color3.new(1, 1, 0))
            end
        end
    end
    ESP.ogMoneyLoop = task.spawn(function()
        while ESP.ogMoneyAtivo do pcall(atualizar); task.wait(6) end
    end)
end

function ESP.pararOGMoney()
    ESP.ogMoneyAtivo = false
    if ESP.ogMoneyLoop then task.cancel(ESP.ogMoneyLoop); ESP.ogMoneyLoop = nil end
    if ESP._ogMoneyCache then
        for obj, gui in pairs(ESP._ogMoneyCache) do
            if gui then pcall(function() gui:Destroy() end) end
        end
        ESP._ogMoneyCache = {}
    end
end

function ESP.iniciarTreeEntities()
    if ESP.treeEntitiesLoop then task.cancel(ESP.treeEntitiesLoop) end
    local function atualizar()
        local TE = Workspace:FindFirstChild("TreeEntity")
        if not TE then return end
        ESP.limparESPs(TE, "👑 TreeLord")
        ESP.limparESPs(TE, "🌿 TreeMinion")
        local function procurar(p)
            for _, item in ipairs(p:GetChildren()) do
                if item.Name == "TreeLord" then
                    ESP.criarESP(item, "👑 TreeLord", Color3.new(1, 0, 0))
                elseif item.Name == "TreeMinion" then
                    ESP.criarESP(item, "🌿 TreeMinion", Color3.new(0, 1, 0))
                end
                if #item:GetChildren() > 0 then procurar(item) end
            end
        end
        procurar(TE)
    end
    ESP.treeEntitiesLoop = task.spawn(function()
        while ESP.treeEntitiesAtivo do pcall(atualizar); task.wait(10) end
    end)
end

function ESP.pararTreeEntities()
    ESP.treeEntitiesAtivo = false
    if ESP.treeEntitiesLoop then task.cancel(ESP.treeEntitiesLoop); ESP.treeEntitiesLoop = nil end
    local TE = Workspace:FindFirstChild("TreeEntity")
    if TE then
        ESP.limparESPs(TE, "👑 TreeLord")
        ESP.limparESPs(TE, "🌿 TreeMinion")
    end
end

local PUMPKIN_MAX_RADIUS = 500
local PUMPKIN_LIMIT = 30

function ESP.iniciarPumpkin()
    if ESP.pumpkinLoop then task.cancel(ESP.pumpkinLoop) end
    ESP._pumpkinCache = ESP._pumpkinCache or {}
    ESP._pumpkinKnown = ESP._pumpkinKnown or {}
    local lastFullScan = 0

    local function getPos(item)
        if item:IsA("BasePart") then return item.Position end
        if item:IsA("Model") then
            local ok, pp = pcall(function() return item:GetPivot().Position end)
            if ok then return pp end
        end
        return nil
    end

    local function fullScan()
        table.clear(ESP._pumpkinKnown)
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item.Name == "IS_FALL_1" then
                ESP._pumpkinKnown[item] = true
            end
        end
    end

    local function atualizar()
        local ch = LocalPlayer.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local meuPos = hrp.Position

        if tick() - lastFullScan > 20 then
            fullScan()
            lastFullScan = tick()
        end

        local cand = {}
        for item in pairs(ESP._pumpkinKnown) do
            if not item.Parent then
                ESP._pumpkinKnown[item] = nil
            else
                local pos = getPos(item)
                if pos then
                    local d = (pos - meuPos).Magnitude
                    if d <= PUMPKIN_MAX_RADIUS then
                        table.insert(cand, { obj = item, dist = d })
                    end
                end
            end
        end
        table.sort(cand, function(a, b) return a.dist < b.dist end)

        local shouldShow = {}
        for i = 1, math.min(#cand, PUMPKIN_LIMIT) do
            shouldShow[cand[i].obj] = true
        end

        for obj, gui in pairs(ESP._pumpkinCache) do
            if not shouldShow[obj] or not obj.Parent then
                if gui then pcall(function() gui:Destroy() end) end
                ESP._pumpkinCache[obj] = nil
            end
        end
        for obj in pairs(shouldShow) do
            if not ESP._pumpkinCache[obj] then
                ESP._pumpkinCache[obj] = ESP.criarESP(obj, "🎃 Pumpkin", Color3.fromRGB(255, 140, 0))
            end
        end
    end

    ESP.pumpkinLoop = task.spawn(function()
        while ESP.pumpkinAtivo do pcall(atualizar); task.wait(8) end
    end)
end

function ESP.pararPumpkin()
    ESP.pumpkinAtivo = false
    if ESP.pumpkinLoop then task.cancel(ESP.pumpkinLoop); ESP.pumpkinLoop = nil end
    if ESP._pumpkinCache then
        for obj, gui in pairs(ESP._pumpkinCache) do
            if gui then pcall(function() gui:Destroy() end) end
        end
        ESP._pumpkinCache = {}
    end
    ESP._pumpkinKnown = nil
end

