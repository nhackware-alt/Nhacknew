local function updateDropdown()
    local newList = getPlayerList()
    if TpDropdown then
        if TpDropdown.SetValues then
            pcall(function() TpDropdown:SetValues(newList) end)
        elseif TpDropdown.Refresh then
            pcall(function() TpDropdown:Refresh(newList, true) end)
        end
    end
    if tpTargetPlayer and not table.find(newList, tpTargetPlayer) then
        tpTargetPlayer = nil
    end
end

