local isIntroDone = false
task.spawn(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Lighting = game:GetService("Lighting")
    local StarterGui = game:GetService("StarterGui")
    local ReplicatedFirst = game:GetService("ReplicatedFirst")
    local ContentProvider = game:GetService("ContentProvider")

    -- 1. ЗАПУСК АУДИО
    task.spawn(function()
        local githubAudioUrl = "https://github.com/nhackware-alt/Nhackware_audios/raw/refs/heads/main/start.mp3"
        local localFileName = "nhackware_start.mp3"
        local success, fileData = pcall(function() return game:HttpGet(githubAudioUrl) end)
        if success and fileData then
            pcall(writefile, localFileName, fileData)
            local assetSuccess, customAssetId = pcall(function() return getcustomasset(localFileName) end)
            if assetSuccess and customAssetId and customAssetId ~= "" then
                local sound = Instance.new("Sound")
                sound.SoundId = customAssetId
                sound.Volume = 1
                sound.Parent = workspace
                pcall(function() sound:Play() end)
                sound.Ended:Connect(function() sound:Destroy() end)
            end
        end
    end)

    -- 2. ВИЗУАЛЬНОЕ ИНТРО
    local CONFIG = {
        BackgroundColor = Color3.fromRGB(255, 255, 255),
        LogoColor = Color3.fromRGB(0, 0, 0),
        LetterSize = 86, WareSize = 38, LogoYOffset = 0, CustomFont = nil,
        WorldBlur = 24, BlurSamples = 19, HideCoreGui = true,
        WaitForGameLoad = true, MaxExtraWait = 8,
    }
    local T = {
        LetterStart = 0.02, LetterStep = 0.07, LetterTime = 0.32,
        WareStart = 1.22, WareTime = 0.48, HoldUntil = 2.30,
        WareOutTime = 0.22, LogoOutDelay = 0.20, LogoOutTime = 0.70,
        BgOutDelay = 0.35, BgOutTime = 0.90,
    }
    local BLUR_IN = 9
    local BLUR_OUT = 14
    local DESIGN_W, DESIGN_H = 512, 288
    local LETTERS = { { "N", -102.2 }, { "H", -49.0 }, { "A", 3.4 }, { "C", 51.8 }, { "K", 101.6 } }
    local LETTER_Y = -16.6
    local WARE_X, WARE_Y = -8.4, 40

    local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
    local playerGui = player:WaitForChild("PlayerGui")

    if playerGui:FindFirstChild("NhackwareIntro") then 
        isIntroDone = true
        return 
    end

    local FONT
    if CONFIG.CustomFont then
        FONT = CONFIG.CustomFont
    else
        local ok, f = pcall(function()
            local base = Font.fromEnum(Enum.Font.Oswald)
            return Font.new(base.Family, Enum.FontWeight.Bold, Enum.FontStyle.Normal)
        end)
        FONT = ok and f or Font.fromEnum(Enum.Font.GothamBlack)
    end

    local SAMPLES = math.max(CONFIG.BlurSamples, 2)
    local OFFSETS = {}
    for i = 0, SAMPLES - 1 do
        local r = (i == 0) and 0 or math.sqrt(i / (SAMPLES - 1))
        local a = i * 2.399963
        OFFSETS[i + 1] = Vector2.new(math.cos(a) * r, math.sin(a) * r)
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "NhackwareIntro"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 10000
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
    pcall(function() gui.ClipToDeviceSafeArea = false end)

    local bg = Instance.new("Frame")
    bg.Name = "Background"
    bg.BackgroundColor3 = CONFIG.BackgroundColor
    bg.BackgroundTransparency = 0
    bg.BorderSizePixel = 0
    bg.Active = true
    bg.Position = UDim2.fromOffset(-1, -1)
    bg.Size = UDim2.new(1, 2, 1, 2)
    bg.ZIndex = 1
    bg.Parent = gui

    local stage = Instance.new("Frame")
    stage.Name = "Stage"
    stage.BackgroundTransparency = 1
    stage.BorderSizePixel = 0
    stage.AnchorPoint = Vector2.new(0.5, 0.5)
    stage.Position = UDim2.fromScale(0.5, 0.5)
    stage.Size = UDim2.fromOffset(DESIGN_W, DESIGN_H)
    stage.ZIndex = 2
    stage.Parent = gui

    local uiScale = Instance.new("UIScale")
    uiScale.Parent = stage

    local function updateScale()
        local s = gui.AbsoluteSize
        if s.X <= 0 or s.Y <= 0 then
            local cam = workspace.CurrentCamera
            s = cam and cam.ViewportSize or Vector2.new(DESIGN_W, DESIGN_H)
        end
        uiScale.Scale = math.min(s.X / DESIGN_W, s.Y / DESIGN_H)
    end
    gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
    updateScale()

    local Unit = {}
    Unit.__index = Unit

    function Unit.new(text, textSize, cx, cy)
        local self = setmetatable({}, Unit)
        self.cx, self.cy = cx, cy
        self.base = UDim2.fromOffset(cx, cy)
        self.labels = {}
        self.alpha, self.blur, self.shown = -1, -1, -1

        for i = 1, SAMPLES do
            local l = Instance.new("TextLabel")
            l.Name = text .. i
            l.AnchorPoint = Vector2.new(0.5, 0.5)
            l.Position = self.base
            l.Size = UDim2.fromOffset(180, 140)
            l.BackgroundTransparency = 1
            l.BorderSizePixel = 0
            l.Text = text
            l.FontFace = FONT
            l.TextSize = textSize
            l.TextColor3 = CONFIG.LogoColor
            l.TextWrapped = false
            l.TextXAlignment = Enum.TextXAlignment.Center
            l.TextYAlignment = Enum.TextYAlignment.Center
            l.TextTransparency = 1
            l.Visible = false
            l.ZIndex = 2
            l.Parent = stage
            self.labels[i] = l
        end
        return self
    end

    function Unit:set(alpha, blur)
        if alpha == self.alpha and blur == self.blur then return end
        self.alpha, self.blur = alpha, blur
        local labels = self.labels
        if alpha <= 0.003 then
            if self.shown ~= 0 then
                for _, l in ipairs(labels) do l.Visible = false end
                self.shown = 0
            end
            return
        end
        if blur < 0.25 then
            local l = labels[1]
            l.Position = self.base
            l.TextTransparency = 1 - alpha
            l.Visible = true
            if self.shown ~= 1 then
                for i = 2, #labels do labels[i].Visible = false end
                self.shown = 1
            end
        else
            local a = math.min(alpha, 0.97)
            local layerAlpha = 1 - (1 - a) ^ (1 / #labels)
            local tr = 1 - layerAlpha
            for i, l in ipairs(labels) do
                local o = OFFSETS[i]
                l.Position = UDim2.fromOffset(self.cx + o.X * blur, self.cy + o.Y * blur)
                l.TextTransparency = tr
                l.Visible = true
            end
            self.shown = #labels
        end
    end

    local cx0 = DESIGN_W / 2
    local cy0 = DESIGN_H / 2 + CONFIG.LogoYOffset

    local letters = {}
    for i, data in ipairs(LETTERS) do
        letters[i] = Unit.new(data[1], CONFIG.LetterSize, cx0 + data[2], cy0 + LETTER_Y)
    end
    local ware = Unit.new("ware", CONFIG.WareSize, cx0 + WARE_X, cy0 + WARE_Y)

    local worldBlur = Instance.new("BlurEffect")
    worldBlur.Name = "NhackwareIntroBlur"
    worldBlur.Size = CONFIG.WorldBlur
    worldBlur.Parent = Lighting

    gui.Parent = playerGui

    pcall(function() ReplicatedFirst:RemoveDefaultLoadingScreen() end)

    local savedCore = {}
    if CONFIG.HideCoreGui then
        for _, item in ipairs(Enum.CoreGuiType:GetEnumItems()) do
            if item ~= Enum.CoreGuiType.All then
                local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, item)
                if ok then savedCore[item] = enabled end
            end
        end
        task.spawn(function()
            for _ = 1, 20 do
                if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.All, false) then return end
                task.wait(0.1)
            end
        end)
    end

    local function restoreCoreGui()
        for item, enabled in pairs(savedCore) do
            pcall(StarterGui.SetCoreGuiEnabled, StarterGui, item, enabled)
        end
    end

    do
        local done = false
        task.spawn(function()
            pcall(function() ContentProvider:PreloadAsync({ letters[1].labels[1], ware.labels[1] }) end)
            done = true
        end)
        local waited = 0
        while not done and waited < 2 do waited += task.wait() end
    end

    local function clamp01(x) return math.clamp(x, 0, 1) end
    local function easeInOut(p)
        if p < 0.5 then return 2 * p * p end
        return 1 - ((-2 * p + 2) ^ 2) / 2
    end

    local t = 0
    local outT = nil
    local conn

    local function finish()
        if conn then conn:Disconnect(); conn = nil end
        if gui then gui:Destroy() end
        if worldBlur then worldBlur:Destroy() end
        restoreCoreGui()
        isIntroDone = true
    end

    conn = RunService.RenderStepped:Connect(function(dt)
        dt = math.min(dt, 0.05)
        t += dt
        updateScale()

        if not outT and t >= T.HoldUntil then
            if not CONFIG.WaitForGameLoad or game:IsLoaded() or t >= T.HoldUntil + CONFIG.MaxExtraWait then
                outT = 0
            end
        elseif outT then
            outT += dt
        end

        local logoQ = 0
        if outT then logoQ = easeInOut(clamp01((outT - T.LogoOutDelay) / T.LogoOutTime)) end
        for i, unit in ipairs(letters) do
            local p = clamp01((t - (T.LetterStart + (i - 1) * T.LetterStep)) / T.LetterTime)
            local a = 1 - (1 - p) ^ 1.7
            local b = BLUR_IN * (1 - p) ^ 2
            if outT then
                a = a * (1 - logoQ)
                b = b + BLUR_OUT * logoQ
            end
            unit:set(a, b)
        end

        do
            local p = clamp01((t - T.WareStart) / T.WareTime)
            local a = 1 - (1 - p) ^ 2.2
            local b = 0
            if outT then
                local q = easeInOut(clamp01(outT / T.WareOutTime))
                a = a * (1 - q)
                b = BLUR_OUT * 0.5 * q
            end
            ware:set(a, b)
        end

        if outT then
            local q = easeInOut(clamp01((outT - T.BgOutDelay) / T.BgOutTime))
            bg.BackgroundTransparency = q
            worldBlur.Size = CONFIG.WorldBlur * (1 - q)
            if outT >= T.BgOutDelay + T.BgOutTime and outT >= T.LogoOutDelay + T.LogoOutTime then
                finish()
            end
        end
    end)
end)

-- Ждем окончания интро перед загрузкой UI
repeat task.wait() until isIntroDone

