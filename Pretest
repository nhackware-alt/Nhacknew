local Engine = {
    Enabled = false,
    CopyFromKart = true,
    ManualAttrs = {
        forwardMaxSpeed   = 60,
        nitroForce        = 20,
        nitroMaxSpeed     = 10,
        nitroAcceleration = 30,
        nitroTime         = 2,
        nitroCooldownTime = 2,
        nitroRechargeTime = 20,
    },
    Speed = 60,
    _hrp = nil, _eng = nil, _vf = nil, _att = nil,
    _conn = nil, _charConn = nil,
}

local function findMyKart()
    local karts = Workspace:FindFirstChild("Karts")
    return karts and karts:FindFirstChild(PlayerName)
end

local function copyKartAttrs(eng)
    if not Engine.CopyFromKart then
        for k, v in pairs(Engine.ManualAttrs) do eng:SetAttribute(k, v) end
        return
    end
    local kart = findMyKart()
    local src = kart and kart:FindFirstChild("Engine")
    if not src then
        for k, v in pairs(Engine.ManualAttrs) do eng:SetAttribute(k, v) end
        return
    end
    for k, v in pairs(src:GetAttributes()) do
        if k == "_isAccelerating" or k == "_isBraking" or k == "_isHandBraking"
        or k == "_isReversing" or k == "_isStopped" or k == "_doingBurnout" then
            eng:SetAttribute(k, false)
        elseif k == "_nitroEnabled" then
            eng:SetAttribute(k, true)
        else
            pcall(function() eng:SetAttribute(k, v) end)
        end
    end
    eng:SetAttribute("_isAccelerating", true)
    eng:SetAttribute("_nitroEnabled", true)
end

local function destroyEngine()
    if Engine._vf  then pcall(function() Engine._vf:Destroy()  end); Engine._vf  = nil end
    if Engine._att then pcall(function() Engine._att:Destroy() end); Engine._att = nil end
    if Engine._eng then pcall(function() Engine._eng:Destroy() end); Engine._eng = nil end
end

local function bindEngine()
    destroyEngine()
    local ch = LocalPlayer.Character
    if not ch then return end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    Engine._hrp = hrp

    local eng = Instance.new("Folder"); eng.Name = "Engine"; eng.Parent = hrp
    copyKartAttrs(eng)

    local att = Instance.new("Attachment")
    att.Name = "EngineAttach"; att.Position = Vector3.new(0, 0, 0); att.Parent = hrp
    Engine._att = att

    local vf = Instance.new("VectorForce")
    vf.Name = "NitroForce"
    vf.Attachment0 = att
    vf.RelativeTo = Enum.ActuatorRelativeTo.World
    vf.ApplyAtCenterOfMass = true
    vf.Force = Vector3.new(0, 0, 0)
    vf.Parent = eng
    Engine._vf = vf

    for _, n in ipairs({ "WheelFLMotor", "WheelFRMotor", "WheelRLMotor", "WheelRRMotor" }) do
        local cc = Instance.new("CylindricalConstraint")
        cc.Name = n; cc.Visible = false; cc.Enabled = false; cc.Parent = eng
    end
    Engine._eng = eng
end

local function tickEngine(dt)
    if not Engine.Enabled then return end
    local hrp = Engine._hrp
    if not hrp or not hrp.Parent then bindEngine(); return end
    if not Engine._vf then bindEngine(); return end

    local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local maxSpeed = Engine.Speed
    local mass = hrp.AssemblyMass

    local md = hum.MoveDirection
    local moving = md.Magnitude > 0.1

    local vel = hrp.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    local horizSpeed = horizVel.Magnitude

    if moving then
        local dir = Vector3.new(md.X, 0, md.Z)
        if dir.Magnitude > 0.01 then
            dir = dir.Unit
            local targetVel = dir * maxSpeed
            
            if horizSpeed < maxSpeed then
                local forceX = (targetVel.X - vel.X) * mass * 50
                local forceZ = (targetVel.Z - vel.Z) * mass * 50
                Engine._vf.Force = Vector3.new(forceX, 0, forceZ)
            else
                Engine._vf.Force = Vector3.new(0, 0, 0)
            end

            if Engine._eng then
                Engine._eng:SetAttribute("_isAccelerating", true)
                Engine._eng:SetAttribute("_nitroEnabled", true)
                Engine._eng:SetAttribute("_speed", horizSpeed)
                Engine._eng:SetAttribute("_chassisSpeed", horizSpeed)
            end
        end
    else
        Engine._vf.Force = Vector3.new(0, 0, 0)
        if Engine._eng then
            Engine._eng:SetAttribute("_isAccelerating", false)
            Engine._eng:SetAttribute("_speed", horizSpeed)
            Engine._eng:SetAttribute("_chassisSpeed", horizSpeed)
        end
    end
end

function Engine.Start()
    if Engine.Enabled then return end
    Engine.Enabled = true
    bindEngine()
    Engine._charConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.3); bindEngine()
    end)
    Engine._conn = RunService.Heartbeat:Connect(function(dt) pcall(tickEngine, dt) end)
end

function Engine.Stop()
    Engine.Enabled = false
    if Engine._conn then Engine._conn:Disconnect(); Engine._conn = nil end
    if Engine._charConn then Engine._charConn:Disconnect(); Engine._charConn = nil end
    destroyEngine()
    Engine._hrp = nil
end

function Engine.SetSpeed(v)        
    v = tonumber(v)
    if v then 
        Engine.Speed = v 
        if Engine._eng then Engine._eng:SetAttribute("forwardMaxSpeed", v) end
    end 
end

function Engine.SetCopyFromKart(v) Engine.CopyFromKart = v and true or false end

