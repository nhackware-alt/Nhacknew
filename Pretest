-- ============================================================
local LoopTP = {
    Enabled = false, Target = nil,
    Distance = 0, OrbitSpeed = 5, Angle = 0,
    LeadMultiplier = 1.5, VerticalOffset = 1.5, PingFallback = 0.06,
    _conn = nil,
}
local function getPingSeconds()
    local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if ok and type(ping) == "number" and ping > 0 then return ping end
    return LoopTP.PingFallback
end
function LoopTP.Start(target, opts)
    if LoopTP._conn then LoopTP._conn:Disconnect(); LoopTP._conn = nil end
    if not target or not target.Character then return end
    opts = opts or {}
    LoopTP.Target = target
    LoopTP.Distance = opts.distance or LoopTP.Distance or 0
    LoopTP.OrbitSpeed = opts.orbitSpeed or LoopTP.OrbitSpeed or 5
    LoopTP.LeadMultiplier = opts.lead or LoopTP.LeadMultiplier or 1.5
    LoopTP.VerticalOffset = opts.verticalOffset or LoopTP.VerticalOffset or 1.5
    LoopTP.Angle = 0
    LoopTP.Enabled = true

    local ch = LocalPlayer.Character
    if ch then
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart then hum.Sit = false; task.wait(0.1) end
    end

    local lastClock = os.clock()
    LoopTP._conn = RunService.Heartbeat:Connect(function()
        if not LoopTP.Enabled then return end
        local t = LoopTP.Target
        if not t or not t.Parent or not t.Character then LoopTP.Stop(); return end
        local myCh = LocalPlayer.Character
        local myRoot = myCh and myCh:FindFirstChild("HumanoidRootPart")
        local tgtRoot = t.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot or not tgtRoot then return end
        local now = os.clock()
        local dt = now - lastClock
        lastClock = now
        if dt <= 0 or dt > 0.25 then dt = 1/60 end
        local ping = getPingSeconds()
        local lead = ping * LoopTP.LeadMultiplier + dt
        local vel = tgtRoot.AssemblyLinearVelocity
        local predicted = tgtRoot.Position + vel * lead
        local offset = Vector3.new(0, LoopTP.VerticalOffset, 0)
        if LoopTP.Distance > 0 then
            LoopTP.Angle = LoopTP.Angle + (LoopTP.OrbitSpeed * dt)
            if LoopTP.Angle >= 360 then LoopTP.Angle = LoopTP.Angle - 360 end
            local rad = math.rad(LoopTP.Angle)
            offset = offset + Vector3.new(math.cos(rad) * LoopTP.Distance, 0, math.sin(rad) * LoopTP.Distance)
        end
        local newPos = predicted + offset
        myRoot.CFrame = CFrame.new(newPos, predicted)
        myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
end
function LoopTP.Stop()
    LoopTP.Enabled = false
    LoopTP.Target = nil
    if LoopTP._conn then LoopTP._conn:Disconnect(); LoopTP._conn = nil end
end
function LoopTP.SetLead(v)     v = tonumber(v); if v then LoopTP.LeadMultiplier = v end end
function LoopTP.SetDistance(v) v = tonumber(v); if v then LoopTP.Distance = v end end
function LoopTP.SetOrbit(v)    v = tonumber(v); if v then LoopTP.OrbitSpeed = v end end
function LoopTP.GetPingMs()
    return math.floor(getPingSeconds() * 1000)
end

