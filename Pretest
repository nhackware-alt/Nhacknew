local Fly = {
    Enabled = false, Force = 300, Holding = false,
    Attachment = nil, VectorForce = nil, InputConn = nil, InputEndConn = nil, Heartbeat = nil,
    MobileGui = nil
}
function Fly.GetRoot()
    local ch = LocalPlayer.Character
    return ch and ch:FindFirstChild("HumanoidRootPart")
end
function Fly.DestroyForce()
    if Fly.VectorForce then Fly.VectorForce:Destroy(); Fly.VectorForce = nil end
    if Fly.Attachment then Fly.Attachment:Destroy(); Fly.Attachment = nil end
end
function Fly.EnsureForce()
    if not Fly.Enabled then return end
    local root = Fly.GetRoot()
    if not root then Fly.DestroyForce(); return end
    if Fly.Attachment and Fly.Attachment.Parent ~= root then Fly.DestroyForce() end
    if not Fly.Attachment then
        local att = Instance.new("Attachment"); att.Name = "FlyAtt"; att.Parent = root
        local vf = Instance.new("VectorForce")
        vf.Name = "FlyForce"; vf.Attachment0 = att
        vf.RelativeTo = Enum.ActuatorRelativeTo.World
        vf.ApplyAtCenterOfMass = true; vf.Force = Vector3.new(0, 0, 0); vf.Parent = root
        Fly.Attachment = att; Fly.VectorForce = vf
    end
    local mass = root.AssemblyMass
    Fly.VectorForce.Force = Fly.Holding and Vector3.new(0, Fly.Force * mass, 0) or Vector3.new(0, 0, 0)
end
function Fly.CreateMobileButton()
    if Fly.MobileGui then return end
    local gui = Instance.new("ScreenGui")
    gui.Name = "FlyMobileGui"
    gui.ResetOnSpawn = false
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 80, 0, 80)
    btn.Position = UDim2.new(0, 20, 0.5, -40)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.BackgroundTransparency = 0.3
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Text = "FLY"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 20
    btn.Parent = gui

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Fly.Holding = true
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Fly.Holding = false
        end
    end)
    
    Fly.MobileGui = gui
end
function Fly.DestroyMobileButton()
    if Fly.MobileGui then Fly.MobileGui:Destroy(); Fly.MobileGui = nil end
end
function Fly.Start()
    if Fly.Heartbeat then Fly.Heartbeat:Disconnect() end
    Fly.Enabled = true
    
    Fly.InputConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.Space then Fly.Holding = true end
    end)
    Fly.InputEndConn = UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Space then Fly.Holding = false end
    end)
    
    Fly.CreateMobileButton()
    Fly.Heartbeat = RunService.Heartbeat:Connect(function() pcall(Fly.EnsureForce) end)
end
function Fly.Stop()
    Fly.Enabled = false; Fly.Holding = false
    if Fly.Heartbeat then Fly.Heartbeat:Disconnect(); Fly.Heartbeat = nil end
    if Fly.InputConn then Fly.InputConn:Disconnect(); Fly.InputConn = nil end
    if Fly.InputEndConn then Fly.InputEndConn:Disconnect(); Fly.InputEndConn = nil end
    Fly.DestroyForce()
    Fly.DestroyMobileButton()
end
