LogService.MessageOut:Connect(function(message, messageType)
    local prefix = "[INFO] "
    if messageType == Enum.MessageType.MessageError then
        prefix = "[ERROR] "
    elseif messageType == Enum.MessageType.MessageWarning then
        prefix = "[WARN] "
    end
    
    table.insert(logHistory, prefix .. tostring(message))
    if #logHistory > 40 then
        table.remove(logHistory, 1)
    end
    
    if not updatePending then
        updatePending = true
        task.delay(0.5, function()
            if consoleDesc then
                pcall(function() consoleDesc:SetDesc(table.concat(logHistory, "\n")) end)
            end
            updatePending = false
        end)
    end
end)

