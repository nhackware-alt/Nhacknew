local FarmState = {
    Enabled = false, Paused = false, RiceCount = 0,
    LastRice = nil, RiceFolder = nil, KartStatus = "не найден",
}
function FarmState.GetRice()
    if not FarmState.RiceFolder then FarmState.RiceFolder = Workspace:FindFirstChild("Rice") end
    if not FarmState.RiceFolder then return nil end
    local K = Workspace:FindFirstChild("Karts")
    local kart = K and K:FindFirstChild(PlayerName)
    local kp = kart and kart.PrimaryPart and kart.PrimaryPart.Position
    if not kp then return nil end
    local live = {}
    for _, rice in ipairs(FarmState.RiceFolder:GetChildren()) do
        if rice:IsA("Model") then
            local hp = rice:GetAttribute("Health")
            local rw = rice:GetAttribute("Reward")
            local pp = rice.PrimaryPart
            if hp and hp > 0 and rw and rw > 0 and pp then
                table.insert(live, { rice = rice, pp = pp, dist = (pp.Position - kp).Magnitude })
            end
        end
    end
    if #live == 0 then return nil end
    table.sort(live, function(a, b) return a.dist < b.dist end)
    for _, e in ipairs(live) do
        if e.rice ~= FarmState.LastRice then FarmState.LastRice = e.rice; return e.rice, e.pp end
    end
    FarmState.LastRice = live[1].rice
    return live[1].rice, live[1].pp
end
function FarmState.UseKart(kart)
    if kart.Name ~= PlayerName then return end
    local seat = kart:FindFirstChildOfClass("VehicleSeat")
    if not seat then return end
    local kR = kart.PrimaryPart
    if not kR then return end
    while kart.Parent and FarmState.Enabled and not FarmState.Paused do
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hum then break end
        if seat.Occupant ~= hum then pcall(function() seat:Sit(hum) end) end
        local rice, part = FarmState.GetRice()
        if rice and part then
            pcall(function()
                kR.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                kR.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
            pcall(function()
                kart:SetPrimaryPartCFrame(part.CFrame * CFrame.new(CONFIG.OFFSET_X, CONFIG.OFFSET_Y, CONFIG.OFFSET_Z))
            end)
            pcall(function()
                kR.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                kR.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
            FarmState.RiceCount = FarmState.RiceCount + 1
            task.wait(0.15)
            local stillHp = rice:GetAttribute("Health")
            if stillHp and stillHp > 0 then
                task.wait(0.15)
                pcall(function()
                    kart:SetPrimaryPartCFrame(part.CFrame * CFrame.new(CONFIG.OFFSET_X, CONFIG.OFFSET_Y, CONFIG.OFFSET_Z))
                end)
                task.wait(0.1)
            end
            FarmState.LastRice = rice
        else
            task.wait(0.3)
        end
        task.wait(0.02)
    end
end
local farmLoop, eatLoop, floodLoop = nil, nil, nil
local function StartFloodLoop()
    if floodLoop then return end
    floodLoop = task.spawn(function()
        while FarmState.Enabled do
            local ch = LocalPlayer.Character
            if ch then
                local F = ch:FindFirstChild("Float")
                if F then pcall(function() F.Disabled = true; F:Destroy() end) end
            end
            task.wait()
        end
        floodLoop = nil
    end)
end
local function StartEatLoop()
    if eatLoop then return end
    eatLoop = task.spawn(function()
        while FarmState.Enabled do
            local stats = LocalPlayer:FindFirstChild("stats")
            local hunger = stats and stats:FindFirstChild("Hunger")
            local ch = LocalPlayer.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hunger and hum and hunger.Value < CONFIG.HUNGER_MIN then
                FarmState.Paused = true
                hum.Sit = false
                task.wait(0.3)
                if hum.Sit then
                    local K = Workspace:FindFirstChild("Karts")
                    local kart = K and K:FindFirstChild(PlayerName)
                    if kart then
                        local seat = kart:FindFirstChildOfClass("VehicleSeat")
                        if seat then pcall(function() seat:Sit(nil) end) end
                    end
                    task.wait(0.3)
                end
                local attempts = 0
                local fails = 0
                while FarmState.Enabled and hunger.Value < CONFIG.HUNGER_MAX and attempts < CONFIG.EAT_MAX_ATTEMPTS do
                    attempts = attempts + 1
                    local ok = AutoEat()
                    fails = ok and 0 or (fails + 1)
                    local w = 0.3
                    if fails > 10 then w = 2 elseif fails > 3 then w = 1 end
                    task.wait(w)
                end
                FarmState.Paused = false
                task.wait(1)
            end
            task.wait(2)
        end
        eatLoop = nil
    end)
end
local function StartFarmLoop()
    if farmLoop then return end
    farmLoop = task.spawn(function()
        FarmState.RiceFolder = Workspace:FindFirstChild("Rice")
        while FarmState.Enabled do
            local K = Workspace:FindFirstChild("Karts")
            local ch = LocalPlayer.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if not FarmState.Paused then
                if not K or not K:FindFirstChild(PlayerName) then
                    FarmState.KartStatus = "не найден"
                    if hum and hum.Health <= 0 then
                        local re = ReplicatedStorage:FindFirstChild("RemoteEvent")
                        if re then pcall(function() re:FireServer("Respawn") end) end
                    else
                        local tool = LocalPlayer.Backpack:FindFirstChild("FarmKart")
                        if tool then tool:Activate(); FarmState.KartStatus = "активирую..."
                        else FarmState.KartStatus = "нет FarmKart" end
                    end
                else
                    FarmState.KartStatus = "работает"
                    local kart = K[PlayerName]
                    for _, v in ipairs(kart:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                    FarmState.UseKart(kart)
                end
            end
            task.wait(2.3)
        end
        farmLoop = nil
    end)
end
function FarmState.Start()
    if FarmState.Enabled then return end
    FarmState.Enabled = true; FarmState.RiceCount = 0; FarmState.LastRice = nil
    StartFarmLoop(); StartEatLoop(); StartFloodLoop()
end
function FarmState.Stop()
    FarmState.Enabled = false; FarmState.Paused = false
end

