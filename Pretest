function GyroLock.Tick()
    if not GyroLock.Enabled then return end
    local root = GyroLock.GetRootPart()
    if not root then GyroLock.RefCFrame = nil; return end
    local av = root.AssemblyAngularVelocity
    if GyroLock.Mode == "damp" then
        local nX = GyroLock.LockX and av.X * (1 - GyroLock.Strength) or av.X
        local nY = GyroLock.LockY and av.Y * (1 - GyroLock.Strength) or av.Y
        local nZ = GyroLock.LockZ and av.Z * (1 - GyroLock.Strength) or av.Z
        root.AssemblyAngularVelocity = Vector3.new(nX, nY, nZ)
    elseif GyroLock.Mode == "freeze" then
        if not GyroLock.RefCFrame then GyroLock.RefCFrame = root.CFrame; return end
        local rx, ry, rz = GyroLock.RefCFrame:ToOrientation()
        local cx, cy, cz = root.CFrame:ToOrientation()
        local nRx = GyroLock.LockX and rx or cx
        local nRy = GyroLock.LockY and ry or cy
        local nRz = GyroLock.LockZ and rz or cz
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(nRx, nRy, nRz)
        local av2 = root.AssemblyAngularVelocity
        root.AssemblyAngularVelocity = Vector3.new(
            GyroLock.LockX and 0 or av2.X,
            GyroLock.LockY and 0 or av2.Y,
            GyroLock.LockZ and 0 or av2.Z)
    end
end
function GyroLock.Start()
