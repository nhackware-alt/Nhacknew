            local och = plr.Character
            local part = och:FindFirstChild(KillAura.TargetPart)
                      or och:FindFirstChild("HumanoidRootPart")
                      or och:FindFirstChild("Head")
            if part then
                local d = (part.Position - myPos).Magnitude
                if d < bestDist then best, bestDist = part, d end
            end
        end
    end
    return best, bestDist
end
function KillAura.Bind()
    local ch = LocalPlayer.Character
    if not ch then return end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if KillAura._bav then pcall(function() KillAura._bav:Destroy() end); KillAura._bav = nil end
    if KillAura._hum and KillAura._hum.Parent and KillAura._origAutoRotate ~= nil then
        pcall(function() KillAura._hum.AutoRotate = KillAura._origAutoRotate end)
    end
    KillAura._hum = hum
    KillAura._hrp = hrp
    KillAura._boundChar = ch
    KillAura._origAutoRotate = hum.AutoRotate
    hum.AutoRotate = false
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "NhackW_Spin"
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, 0, 0)
    bav.P = 3000
    bav.Parent = hrp
    KillAura._bav = bav
end
function KillAura.WatchCharacter()
    if KillAura._charConn then KillAura._charConn:Disconnect() end
    KillAura._charConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.2); KillAura.Bind()
    end)
end
local function angleDelta(from, to)
    local d = to - from
    while d >  math.pi do d = d - math.pi * 2 end
    while d < -math.pi do d = d + math.pi * 2 end
    return d
end
function KillAura.Tick(dt)
    if not KillAura.Enabled then return end
    local ch = LocalPlayer.Character
    if not ch or ch ~= KillAura._boundChar then KillAura.Bind(); return end
    local hrp = KillAura._hrp
    local bav = KillAura._bav
    if not hrp or not hrp.Parent or not bav or not bav.Parent then return end
    local target = KillAura.GetClosest()
    KillAura.CurrentTarget = target
    if not target then bav.AngularVelocity = Vector3.new(0, 0, 0); return end
    local myPos = hrp.Position
    local tgtPos = target.Position
    local flat = Vector3.new(tgtPos.X - myPos.X, 0, tgtPos.Z - myPos.Z)
    if flat.Magnitude < 0.05 then bav.AngularVelocity = Vector3.new(0, 0, 0); return end
    flat = flat.Unit
    local _, curY, _ = hrp.CFrame:ToOrientation()
    local desiredY = math.atan2(-flat.X, -flat.Z)
    local dY = angleDelta(curY, desiredY)
    local maxRad = math.rad(KillAura.MaxRate)
    local angVelY = math.clamp(dY * KillAura.Gain, -maxRad, maxRad)
    bav.AngularVelocity = Vector3.new(0, angVelY, 0)
end
function KillAura.Start()
    if KillAura._conn then return end
    KillAura.Enabled = true
    KillAura.Bind()
    KillAura.WatchCharacter()
    KillAura._conn = RunService.Heartbeat:Connect(function(dt) pcall(KillAura.Tick, dt) end)
end
function KillAura.Stop()
    KillAura.Enabled = false
    if KillAura._conn then KillAura._conn:Disconnect(); KillAura._conn = nil end
    if KillAura._charConn then KillAura._charConn:Disconnect(); KillAura._charConn = nil end
    if KillAura._bav then pcall(function() KillAura._bav:Destroy() end); KillAura._bav = nil end
    if KillAura._hum and KillAura._hum.Parent and KillAura._origAutoRotate ~= nil then
        pcall(function() KillAura._hum.AutoRotate = KillAura._origAutoRotate end)
    end
    KillAura._hum = nil
    KillAura._hrp = nil
    KillAura._boundChar = nil
    KillAura.CurrentTarget = nil
end
function KillAura.SetMaxRate(v)   v = tonumber(v); if v then KillAura.MaxRate = v end end
function KillAura.SetGain(v)      v = tonumber(v); if v then KillAura.Gain = v end end
function KillAura.SetMaxDist(v)   v = tonumber(v); if v then KillAura.MaxDist = v end end
function KillAura.SetTargetPart(v) KillAura.TargetPart = v end

