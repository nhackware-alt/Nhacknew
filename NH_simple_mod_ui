--[[
    Fluent UI — Dark Navy Edition
    Тёмно-синяя тема · мобильная адаптация · загрузка иконок с URL · ru/en/by/ua
    Один файл. Меняешь ORIGINAL_FLUENT_URL ниже, хостишь, лоадишь loadstring'ом.
]]

local ORIGINAL_FLUENT_URL = "https://github.com/dawid-scripts/Fluent/releases/download/1.1.0/main.lua"

local __patch = (function()
    local HttpService      = game:GetService('HttpService')
    local UserInputService = game:GetService('UserInputService')
    local TweenService     = game:GetService('TweenService')

    local CONFIG_PATH = 'fluent_darknavy_config.json'

    local function is_mobile()
        return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    end

    local function load_config()
        if not (isfile and readfile) then return {} end
        if not isfile(CONFIG_PATH) then return {} end
        local ok, data = pcall(readfile, CONFIG_PATH)
        if not ok or type(data) ~= 'string' then return {} end
        local ok2, parsed = pcall(HttpService.JSONDecode, HttpService, data)
        if ok2 and type(parsed) == 'table' then return parsed end
        return {}
    end

    local function save_config(cfg)
        if not writefile then return end
        local ok, data = pcall(HttpService.JSONEncode, HttpService, cfg)
        if ok then pcall(writefile, CONFIG_PATH, data) end
    end

    -- ===== remote icons (GitHub / Discord CDN / любой http) =====
    local __icon_cache = {}
    local function fetch_remote_icon(url)
        if type(url) ~= 'string' then return nil end
        if url:match('^rbxasset') or url:match('^rbxthumb') then return url end
        if not url:match('^https?://') then return nil end
        if __icon_cache[url] then return __icon_cache[url] end
        if not (getcustomasset and writefile) then return nil end
        local ext = 'png'
        local e = url:match('%.(%w+)$')
        if e and #e <= 5 then ext = e end
        local name = 'fluent_icon_' .. HttpService:GenerateGUID(false) .. '.' .. ext
        local ok1, body = pcall(function() return game:HttpGet(url) end)
        if not ok1 or type(body) ~= 'string' or #body < 16 then return nil end
        if not pcall(writefile, name, body) then return nil end
        local ok3, asset = pcall(getcustomasset, name)
        if ok3 and type(asset) == 'string' then
            __icon_cache[url] = asset
            return asset
        end
        return nil
    end

    -- ===== dark navy palette =====
    local DARK_NAVY = {
        Name              = 'Dark',
        Accent            = Color3.fromRGB(80, 140, 235),
        AcrylicMain       = Color3.fromRGB(10, 12, 22),
        AcrylicBorder     = Color3.fromRGB(35, 45, 75),
        AcrylicGradient   = ColorSequence.new(Color3.fromRGB(15, 20, 40), Color3.fromRGB(8, 10, 18)),
        AcrylicNoise      = 0.92,
        TitleBarLine      = Color3.fromRGB(25, 32, 55),
        Tab               = Color3.fromRGB(35, 45, 75),
        Element           = Color3.fromRGB(42, 55, 90),
        ElementBorder     = Color3.fromRGB(15, 20, 38),
        InElementBorder   = Color3.fromRGB(45, 58, 92),
        ElementTransparency = 0.65,
        ToggleSlider      = Color3.fromRGB(35, 45, 75),
        ToggleToggled     = Color3.fromRGB(80, 140, 235),
        SliderRail        = Color3.fromRGB(30, 38, 68),
        DropdownFrame     = Color3.fromRGB(30, 38, 68),
        DropdownHolder    = Color3.fromRGB(15, 20, 38),
        DropdownBorder    = Color3.fromRGB(20, 28, 50),
        DropdownOption    = Color3.fromRGB(30, 38, 68),
        Keybind           = Color3.fromRGB(30, 38, 68),
        Input             = Color3.fromRGB(20, 26, 46),
        InputFocused      = Color3.fromRGB(5, 8, 16),
        InputIndicator    = Color3.fromRGB(60, 90, 160),
        Dialog            = Color3.fromRGB(15, 20, 38),
        DialogHolder      = Color3.fromRGB(10, 14, 28),
        DialogHolderLine  = Color3.fromRGB(20, 28, 50),
        DialogButton      = Color3.fromRGB(20, 28, 50),
        DialogButtonBorder= Color3.fromRGB(40, 55, 95),
        DialogBorder      = Color3.fromRGB(30, 42, 72),
        DialogInput       = Color3.fromRGB(18, 24, 42),
        DialogInputLine   = Color3.fromRGB(60, 90, 160),
        Text              = Color3.fromRGB(220, 230, 245),
        SubText           = Color3.fromRGB(140, 155, 185),
        Hover             = Color3.fromRGB(35, 45, 75),
        HoverChange       = 0.05,
    }

    local TRANSLATIONS = {
        en = { loading='loading...', lang_saved='Language set: English' },
        ru = { loading='загрузка...', lang_saved='Язык установлен: Русский' },
        by = { loading='загрузка...', lang_saved='Мова ўсталявана: Беларуская' },
        ua = { loading='завантаження...', lang_saved='Мову встановлено: Українська' },
    }
    local LANG_OPTIONS = {
        { code='ru', label='Русский'    },
        { code='en', label='English'    },
        { code='by', label='Беларуская' },
        { code='ua', label='Українська' },
    }

    -- ===== loading + lang picker =====
    local function show_loading_and_lang(Fluent)
        local gui = Fluent.GUI
        if not gui then return end

        local cfg        = load_config()
        local saved_lang = cfg.language

        local function mk_panel(w, h)
            local f = Instance.new('Frame')
            f.Size = UDim2.fromOffset(w, h)
            f.Position = UDim2.new(0.5, 0, 0.5, 0)
            f.AnchorPoint = Vector2.new(0.5, 0.5)
            f.BackgroundColor3 = DARK_NAVY.AcrylicMain
            f.BackgroundTransparency = 0.05
            f.BorderSizePixel = 0
            f.ZIndex = 9000
            f.Parent = gui
            local c = Instance.new('UICorner'); c.CornerRadius = UDim.new(0, 8); c.Parent = f
            local s = Instance.new('UIStroke')
            s.Transparency = 0.5; s.Color = DARK_NAVY.AcrylicBorder
            s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = f
            return f
        end

        local splash = mk_panel(220, 70)
        local spl_label = Instance.new('TextLabel')
        spl_label.Text = TRANSLATIONS.en.loading
        spl_label.Size = UDim2.fromScale(1, 1)
        spl_label.BackgroundTransparency = 1
        spl_label.TextColor3 = DARK_NAVY.Text
        spl_label.Font = Enum.Font.GothamMedium
        spl_label.TextSize = 18
        spl_label.Parent = splash
        local spl_scale = Instance.new('UIScale'); spl_scale.Scale = 0.85; spl_scale.Parent = splash
        TweenService:Create(spl_scale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale=1}):Play()

        task.wait(1)

        if saved_lang and TRANSLATIONS[saved_lang] then
            TweenService:Create(splash, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency=1}):Play()
            TweenService:Create(spl_label, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {TextTransparency=1}):Play()
            task.wait(0.45); splash:Destroy()
            Fluent.CurrentLang = saved_lang
            Fluent.Lang        = TRANSLATIONS[saved_lang]
            return
        end

        local sel = mk_panel(340, 220)
        local sel_title = Instance.new('TextLabel')
        sel_title.Text = 'Language / Язык / Мова'
        sel_title.Size = UDim2.new(1, -40, 0, 28)
        sel_title.Position = UDim2.fromOffset(20, 15)
        sel_title.BackgroundTransparency = 1
        sel_title.TextColor3 = DARK_NAVY.Text
        sel_title.Font = Enum.Font.GothamBold
        sel_title.TextSize = 17
        sel_title.TextXAlignment = Enum.TextXAlignment.Left
        sel_title.Parent = sel

        local holder = Instance.new('Frame')
        holder.Size = UDim2.new(1, -40, 1, -75)
        holder.Position = UDim2.fromOffset(20, 55)
        holder.BackgroundTransparency = 1
        holder.Parent = sel

        local list = Instance.new('UIListLayout')
        list.Padding = UDim.new(0, 8)
        list.FillDirection = Enum.FillDirection.Vertical
        list.Parent = holder

        local function pick_lang(code)
            local c2 = load_config(); c2.language = code; save_config(c2)
            Fluent.CurrentLang = code
            Fluent.Lang        = TRANSLATIONS[code]
            TweenService:Create(sel, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency=1}):Play()
            TweenService:Create(sel_title, TweenInfo.new(0.35), {TextTransparency=1}):Play()
            for _, ch in ipairs(holder:GetChildren()) do
                if ch:IsA('TextButton') then
                    TweenService:Create(ch, TweenInfo.new(0.35), {BackgroundTransparency=1, TextTransparency=1}):Play()
                end
            end
            task.wait(0.4); sel:Destroy()
            pcall(function()
                Fluent:Notify({ Title='Language', Content=TRANSLATIONS[code].lang_saved, Duration=3 })
            end)
        end

        for _, opt in ipairs(LANG_OPTIONS) do
            local b = Instance.new('TextButton')
            b.Size = UDim2.new(1, 0, 0, 34)
            b.BackgroundColor3 = DARK_NAVY.Element
            b.BackgroundTransparency = 1
            b.BorderSizePixel = 0
            b.Text = opt.label
            b.TextColor3 = DARK_NAVY.Text
            b.TextTransparency = 1
            b.Font = Enum.Font.GothamMedium
            b.TextSize = 15
            b.AutoButtonColor = false
            b.Parent = holder
            local c = Instance.new('UICorner'); c.CornerRadius = UDim.new(0, 6); c.Parent = b
            b.MouseEnter:Connect(function()
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundTransparency=0.1}):Play()
            end)
            b.MouseLeave:Connect(function()
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundTransparency=0.35}):Play()
            end)
            b.MouseButton1Click:Connect(function() pick_lang(opt.code) end)
        end

        TweenService:Create(splash, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency=1, Size=UDim2.fromOffset(260, 80)}):Play()
        TweenService:Create(spl_label, TweenInfo.new(0.35), {TextTransparency=1}):Play()

        task.delay(0.15, function()
            TweenService:Create(sel, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency=0.05}):Play()
            TweenService:Create(sel_title, TweenInfo.new(0.4), {TextTransparency=0}):Play()
            for _, ch in ipairs(holder:GetChildren()) do
                if ch:IsA('TextButton') then
                    TweenService:Create(ch, TweenInfo.new(0.35), {BackgroundTransparency=0.35, TextTransparency=0}):Play()
                end
            end
        end)

        task.wait(0.65); splash:Destroy()
    end

    -- ===== CreateWindow wrapper: theme default + mobile + force opaque =====
    local function patch_create_window(Fluent)
        local orig = Fluent.CreateWindow
        Fluent.CreateWindow = function(self, config)
            config = config or {}
            if config.Theme == nil then config.Theme = 'Dark' end
            local win = orig(self, config)
            if not win then return win end

            pcall(function()
                self.Transparency = false
                self:ToggleTransparency(false)
            end)

            if not is_mobile() then return win end

            if win.Root then
                local scale = Instance.new('UIScale')
                scale.Scale = 0.8
                scale.Parent = win.Root
            end

            local btn = Instance.new('TextButton')
            btn.Name = 'FluentMobileToggle'
            btn.Size = UDim2.fromOffset(54, 54)
            btn.Position = UDim2.new(1, -66, 0.5, 0)
            btn.AnchorPoint = Vector2.new(0, 0.5)
            btn.BackgroundColor3 = DARK_NAVY.Element
            btn.BackgroundTransparency = 0.05
            btn.BorderSizePixel = 0
            btn.Text = ''
            btn.AutoButtonColor = false
            btn.ZIndex = 10000
            btn.Parent = self.GUI

            local c = Instance.new('UICorner'); c.CornerRadius = UDim.new(1, 0); c.Parent = btn
            local s = Instance.new('UIStroke')
            s.Transparency = 0.35; s.Color = DARK_NAVY.InElementBorder
            s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = btn

            local lbl = Instance.new('TextLabel')
            lbl.Text = '×'
            lbl.Size = UDim2.fromScale(1, 1)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = DARK_NAVY.Text
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 24
            lbl.Parent = btn

            btn.MouseButton1Click:Connect(function()
                pcall(function()
                    win:Minimize()
                    lbl.Text = win.Minimized and '☰' or '×'
                end)
            end)

            return win
        end
    end

    -- ===== icon patch =====
    local function patch_icons(Fluent)
        local orig = Fluent.GetIcon
        Fluent.GetIcon = function(self, icon_id)
            if type(icon_id) == 'string' and icon_id:match('^https?://') then
                return fetch_remote_icon(icon_id)
            end
            if orig then
                local ok, r = pcall(orig, self, icon_id)
                if ok then return r end
            end
            return nil
        end
    end

    -- ===== theme swap =====
    local function patch_theme(Fluent)
        if not (Fluent.Themes and Fluent.Themes.Dark) then return end
        local t = Fluent.Themes.Dark
        for k, v in pairs(DARK_NAVY) do t[k] = v end
    end

    -- ===== entry =====
    local function run(Fluent)
        patch_theme(Fluent)
        patch_icons(Fluent)
        patch_create_window(Fluent)

        Fluent.Lang         = TRANSLATIONS.en
        Fluent.CurrentLang  = 'en'
        Fluent.Translations = TRANSLATIONS
        function Fluent:SetLang(code)
            if TRANSLATIONS[code] then
                self.CurrentLang = code
                self.Lang        = TRANSLATIONS[code]
                local c2 = load_config(); c2.language = code; save_config(c2)
            end
        end

        task.spawn(function() pcall(show_loading_and_lang, Fluent) end)
        return Fluent
    end

    return run
end)()

local __original = loadstring(game:HttpGet(ORIGINAL_FLUENT_URL))()
return __patch(__original)
